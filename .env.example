# Puerto del servidor
PORT=3000

# Cadena de conexión a MongoDB (local o Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/tienda_virtual

# Secreto para firmar los JWT (usar una cadena larga y aleatoria)
JWT_SECRET=cambia_este_valor_por_un_secreto_largo
JWT_EXPIRES_IN=1h

# Costo del hash de bcrypt
BCRYPT_SALT_ROUNDS=10

# Usuario administrador que crea el script de semilla (npm run seed)
ADMIN_EMAIL=admin@tienda.com
ADMIN_PASSWORD=cambia_esta_clave
